# Firebase Configuration for Matrix Club Admin Panel
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Restricted Google Sign-In College Email Domain (Default: vitbhopal.ac.in)
VITE_COLLEGE_EMAIL_DOMAIN=vitbhopal.ac.in

# ImageKit CDN & Direct Upload Settings (Optional)
VITE_IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/Rakshitrajvit
VITE_IMAGEKIT_AUTH_ENDPOINT=https://your-api.com/imagekit-auth
